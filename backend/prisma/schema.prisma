generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum GameRole {
  DM
  PLAYER
}

enum CombatantType {
  PLAYER
  ENEMY
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  characters   Character[]
  memberships  GameMember[]
  createdGames Game[]          @relation("GameDM")
  selections   GameCharacter[]
  diceRolls    DiceRoll[]  
}

model Game {
  id          String   @id @default(cuid())
  name        String
  description String?
  inviteCode  String   @unique
  dmUserId    String
  dmNotes     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dm              User             @relation("GameDM", fields: [dmUserId], references: [id])
  members         GameMember[]
  selections      GameCharacter[]
  battleMaps      BattleMap[]
  combatEncounter CombatEncounter?
  diceRolls       DiceRoll[]
  npcs            NpcPreset[]
  monsters        MonsterPreset[]

  @@index([dmUserId])
}

model GameMember {
  id       String   @id @default(cuid())
  gameId   String
  userId   String
  role     GameRole @default(PLAYER)
  joinedAt DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([userId])
}

model Character {
  id           String  @id @default(cuid())
  ownerUserId  String
  name         String
  raceId       String?
  classId      String?
  subclassId   String?
  backgroundId String?
  level        Int     @default(1)

  sheetData Json @default("{}")

  tokenImagePath    String?
  portraitImagePath String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  selections GameCharacter[]
  combatants Combatant[]

  @@index([ownerUserId])
}

model GameCharacter {
  id          String   @id @default(cuid())
  gameId      String
  userId      String
  characterId String
  isActive    Boolean  @default(true)
  selectedAt  DateTime @default(now())
  journal String @default("")

  game      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId, characterId])
  @@index([userId])
  @@index([characterId])
  
}

model BattleMap {
  id          String   @id @default(cuid())
  gameId      String
  name        String
  rows        Int
  cols        Int
  gridData    Json
  isPublished Boolean  @default(false)
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model CombatEncounter {
  id               String   @id @default(cuid())
  gameId           String   @unique
  currentTurnIndex Int      @default(0)
  round            Int      @default(1)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  game       Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  combatants Combatant[]
  logs       CombatLog[]

  @@index([gameId])
}

model Combatant {
  id          String        @id @default(cuid())
  encounterId String
  type        CombatantType

  characterId String?
  ownerUserId String?

  name String
  hp   Int
  maxHp Int
  ac   Int
  x    Int
  y    Int
  initiative Int

  // Velocidad y movimiento (1 casilla = 5 pies)
  speed        Int @default(30)
  movementUsed Int @default(0)

  // Recursos de turno
  hasAction      Boolean @default(true)
  hasBonusAction Boolean @default(true)
  hasReaction    Boolean @default(true)
  isDashing      Boolean @default(false)

  // Stats base D&D
  str Int @default(10)
  dex Int @default(10)
  con Int @default(10)
  int Int @default(10)
  wis Int @default(10)
  cha Int @default(10)

  // Condiciones activas: ["poisoned", "stunned", ...]
  conditions Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  encounter CombatEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  character Character?      @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@index([encounterId])
  @@index([characterId])
  @@index([ownerUserId])
}

model CombatLog {
  id          String   @id @default(cuid())
  encounterId String
  round       Int
  actorName   String
  action      String
  detail      String
  rolls       Json     @default("[]")
  createdAt   DateTime @default(now())

  encounter CombatEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
}

model ClassPreset {
  id                  String   @id
  name                String
  source              String
  description         String?
  hitDie              Int
  primaryAbilities    String[]
  savingThrows        String[]
  armorTraining       String[]
  weaponTraining      String[]
  toolTraining        String[]
  skillChoices        String[]
  skillChoiceCount    Int      @default(2)
  spellcastingType    String   @default("NONE")
  spellcastingAbility String?
  isOfficial          Boolean  @default(true)
  isSrd               Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  subclasses SubclassPreset[]
  features   ClassFeaturePreset[]
}

model SubclassPreset {
  id            String   @id
  classPresetId String
  name          String
  source        String
  description   String?
  role          String?
  strength      String?
  isSrd         Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  classPreset ClassPreset             @relation(fields: [classPresetId], references: [id], onDelete: Cascade)
  features    SubclassFeaturePreset[]

  @@index([classPresetId])
}

model ClassFeaturePreset {
  id            String   @id @default(cuid())
  classPresetId String
  level         Int
  name          String
  summary       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  classPreset ClassPreset @relation(fields: [classPresetId], references: [id], onDelete: Cascade)

  @@index([classPresetId])
  @@index([level])
}

model SubclassFeaturePreset {
  id               String   @id @default(cuid())
  subclassPresetId String
  level            Int
  name             String
  summary          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subclassPreset SubclassPreset @relation(fields: [subclassPresetId], references: [id], onDelete: Cascade)

  @@index([subclassPresetId])
  @@index([level])
}

model RacePreset {
  id             String   @id
  name           String
  source         String   @default("SRD")
  speed          Int      @default(30)
  size           String   @default("Medium")
  abilityBonuses Json     @default("{}")
  traits         String[]
  languages      String[]
  appearance     String   @default("")   // ← NUEVO: descripción breve de apariencia física
  commonClasses  String[] @default([])   // ← NUEVO: clases más comunes/recomendadas para esta raza
  isSrd          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}


model BackgroundPreset {
  id                  String   @id
  name                String
  source              String   @default("SRD")
  skillProficiencies  String[]
  toolProficiencies   String[]
  languages           Int      @default(0) // cantidad de idiomas a elegir
  feature             String
  featureDescription  String?
  equipment           String[]
  isSrd               Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model WeaponPreset {
  id               String   @id
  name             String
  category         String   // "simple" | "martial"
  attackType       String   // "melee" | "ranged"
  damageDice       String   // "1d8"
  versatileDice    String?  // "1d10" — si tiene la propiedad Versátil
  damageType       String   // "cortante" | "perforante" | "contundente"
  properties       String[] // ["Ligera", "Finesse", "Arrojadiza"]
  rangeNormal      Int?     // pies, para armas a distancia o arrojadizas
  rangeLong        Int?     // pies, alcance largo
  isFinesse        Boolean  @default(false)
  isTwoHanded      Boolean  @default(false)
  isLight          Boolean  @default(false)
  isHeavy          Boolean  @default(false)
  isReach          Boolean  @default(false)
  isThrown         Boolean  @default(false)
  requiresAmmo     Boolean  @default(false)
  requiresLoading  Boolean  @default(false)
  isSpecial        Boolean  @default(false)
  source           String   @default("SRD 2014")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SpellPreset {
  id            String   @id
  name          String
  level         Int      // 0 = truco (cantrip)
  school        String
  castingTime   String
  range         String   // texto para mostrar, ej. "60 pies (18 m)"
  rangeFeet     Int?
  components    String[] // ["V", "S", "M"]
  duration      String
  concentration Boolean  @default(false)
  ritual        Boolean  @default(false)
  classes       String[] // ["Mago", "Hechicero"]
  description   String

  attackType    String?  // "melee_spell" | "ranged_spell" | null
  savingThrow   String?  // "strength" | "dexterity" | ... | null
  damageDice    String?  // "1d6"
  damageType    String?  // "ácido", "fuego", etc.
  healingDice   String?  // "1d8"

  areaShape     String?  // "cone" | "cube" | "sphere" | "line" | null
  areaSizeFeet  Int?

  higherLevels  String?  // texto libre de escalado con espacios de nivel superior
  notes         String?
  source        String   @default("Personalizado")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DiceRoll {
  id            String   @id @default(cuid())
  gameId        String
  userId        String
  characterName String
  expression    String   // ej. "1d20+5"
  rolls         Json     @default("[]") // ej. [14]
  modifier      Int      @default(0)
  total         Int
  createdAt     DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model NpcPreset {
  id          String   @id @default(cuid())
  gameId      String
  name        String
  description String   @default("")
  notes       String   @default("")
  hp          Int?
  maxHp       Int?
  ac          Int?
  imagePath   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model MonsterPreset {
  id          String   @id @default(cuid())
  gameId      String
  name        String
  description String   @default("")
  notes       String   @default("")
  hp          Int?
  maxHp       Int?
  ac          Int?
  speed       Int?
  damageDice  String?
  damageType  String?
  source      String   @default("Personalizado")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

// ─── Forma Salvaje (Druida) ─────────────────────────────────────────────────
// Catálogo de bestias en las que un druida puede transformarse. minDruidLevel
// y minMoonDruidLevel son el nivel mínimo de personaje al que se desbloquea
// esa bestia para un druida estándar / Círculo de la Luna respectivamente;
// null significa que esa vía nunca la desbloquea (p.ej. los elementales solo
// están disponibles para Círculo de la Luna desde nivel 10).
model BeastPreset {
  id                   String   @id
  name                 String
  nameEn               String?
  cr                   Float // valor numérico (0.125 = 1/8) para comparar contra el máximo permitido
  crLabel              String // "1/8", "1/4", "1/2", "1", "2"...
  ac                   Int
  hp                   Int
  hitDice              String // "4d10+12"
  speedWalk            Int      @default(0)
  speedFly             Int      @default(0)
  speedSwim            Int      @default(0)
  speedClimb           Int      @default(0)
  speedBurrow          Int      @default(0)
  size                 String
  strength             Int
  dexterity            Int
  constitution         Int
  attacks              Json     @default("[]") // [{ name, attackBonus, damage }]
  traits               String   @default("") // rasgos de combate/generales (texto libre)
  vulnerabilities      String?
  resistances          String?
  immunities           String?
  conditionImmunities  String?
  multiattack          Boolean  @default(false)
  minDruidLevel        Int? // nivel mínimo para druida estándar (null = no disponible)
  minMoonDruidLevel    Int? // nivel mínimo para Círculo de la Luna (null = no disponible)
  tokenImagePath       String? // imagen que reemplaza el token del personaje en el mapa de combate mientras está transformado
  source               String   @default("SRD")
  isSrd                Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ─── Catálogo global de monstruos para el mapa de combate ─────────────────────
// Bestiario reutilizable entre partidas (a diferencia de MonsterPreset, que
// vive dentro de una partida puntual para la Pantalla del DM). Administrado
// desde /admin/monsters. Mismo shape que BeastPreset menos los campos
// exclusivos de Forma Salvaje.
model MonsterCatalogPreset {
  id                  String   @id
  name                String
  nameEn              String?
  cr                  Float // valor numérico (0.125 = 1/8) para ordenar/comparar
  crLabel             String // "1/8", "1/4", "1/2", "1", "2"...
  ac                  Int
  hp                  Int
  hitDice             String // "2d6"
  speedWalk           Int      @default(0)
  speedFly            Int      @default(0)
  speedSwim           Int      @default(0)
  speedClimb          Int      @default(0)
  speedBurrow         Int      @default(0)
  size                String
  strength            Int
  dexterity           Int
  constitution        Int
  attacks             Json     @default("[]") // [{ name, attackBonus, reach, rangeShort, rangeLong, damage, damageType }]
  traits              String   @default("")
  vulnerabilities     String?
  resistances         String?
  immunities          String?
  conditionImmunities String?
  multiattack         Boolean  @default(false)
  tokenImagePath      String?
  source              String   @default("Personalizada")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}